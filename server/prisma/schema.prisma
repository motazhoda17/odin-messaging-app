// Prisma schema for the Messaging App.
// Run `npx prisma migrate dev` after changing this file to create a new migration.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// The connection URL lives in prisma.config.js (Prisma 7 style), not here.
datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String
  bio          String   @default("")
  // A link to an image (we don't host uploads, so a URL keeps things simple).
  avatarUrl    String   @default("")
  // Updated on every authenticated request, used to show who is "online".
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  memberships ConversationMember[]
  messages    Message[]
}

// A conversation is either a direct message (exactly 2 members)
// or a group chat (isGroup = true, has a name, 2+ members).
model Conversation {
  id        Int      @id @default(autoincrement())
  name      String?
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  // Bumped whenever a message is sent so the inbox can be sorted by activity.
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

// Join table between users and conversations (many-to-many).
model ConversationMember {
  conversationId Int
  userId         Int
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             Int      @id @default(autoincrement())
  content        String
  createdAt      DateTime @default(now())
  senderId       Int
  conversationId Int

  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
