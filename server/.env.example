# Copy this file to .env and fill in real values. Never commit .env!

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/messaging_app"

# Long random string used to sign JSON Web Tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# Port for the API server
PORT=3000

# URL of the React front end (for CORS). Comma-separate multiple origins.
CLIENT_ORIGIN="http://localhost:5173"
